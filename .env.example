# ── Supabase ──────────────────────────────────────────────────────────
# Project settings → API Keys (use the MODERN keys, not "Legacy")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# "Publishable key" (sb_publishable_...) — safe for the browser, RLS applies
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# "Secret key" (sb_secret_...) — server-only, bypasses RLS, NEVER expose
SUPABASE_SECRET_KEY=sb_secret_...

# Dashboard → Connect → "Session pooler" URI (port 5432).
# IMPORTANT: use a *.pooler.supabase.com host, NOT db.<ref>.supabase.co —
# the direct host is IPv6-only and hangs on IPv4 networks.
# (On Vercel you can switch to the Transaction pooler, port 6543 — our
# driver sets prepare:false so both modes work.)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Company autocomplete (optional) ───────────────────────────────────
# Brandfetch client id (free at developers.brandfetch.com → Brand Search API).
# Without it, company entry is manual: name + optional domain (logo falls
# back to the domain's favicon).
# BRANDFETCH_CLIENT_ID=

# ── Location map (optional) ───────────────────────────────────────────
# Google Cloud → APIs & Services → Credentials → API key, with the
# "Maps JavaScript API" enabled (add "Geocoding API" too if you want the
# admin page's "Find it" button to look up coordinates from a place name).
# A JS map is loaded by the browser, so this key IS public on the pages
# that draw one — restrict it under Application restrictions → HTTP
# referrers, and to those two APIs under API restrictions.
# Without it, the team-matching page lists the locations without a map.
# GOOGLE_MAPS_API_KEY=

# ── Feedback email (optional) ─────────────────────────────────────────
# Resend key (free at resend.com). Without it, exit-form submissions are
# stored in the database but no notification email is sent.
# RESEND_API_KEY=
# Verified sender; the resend.dev address works for testing.
# RESEND_FROM="Team Matching <onboarding@resend.dev>"
# Where notifications go; defaults to the contact section's email.
# NOTIFY_EMAIL=
